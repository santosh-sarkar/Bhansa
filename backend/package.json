{
  "name": "bansa-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Bansa backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit && tsc -p prisma && tsc -p tests",
    "test": "jest --coverage",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.4.0",
    "@prisma/client": "6.19.3",
    "argon2": "^0.41.1",
    "bullmq": "^5.38.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "5.3.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.6.0",
    "jose": "^5.9.2",
    "pino": "^9.6.0",
    "resend": "^4.1.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/argon2": "0.15.4",
    "@types/cookie-parser": "1.4.7",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "@types/swagger-jsdoc": "6.0.4",
    "@types/swagger-ui-express": "4.1.6",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "jest": "29.7.0",
    "pino-pretty": "13.0.0",
    "prettier": "3.9.10",
    "prisma": "6.19.3",
    "supertest": "7.3.2",
    "ts-jest": "29.2.5",
    "tsc-alias": "1.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "6.4.0"
  }
}
