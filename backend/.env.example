# Copy to backend/.env and fill in. Never commit the real file.
# Variable names follow docs/TRD.md section 10.

# Required now
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Neon or local Postgres. Add sslmode=require for Neon.
DATABASE_URL=postgresql://user:password@host:5432/bansa
TEST_DATABASE_URL=postgresql://user:password@localhost:5433/bansa_test
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_DOMAIN=localhost

# Required from the payments task onward. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Required from the menu image upload task onward
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required from the email task onward
RESEND_API_KEY=
EMAIL_FROM=

# Required from the eSewa task onward
ESEWA_FORM_URL=
ESEWA_STATUS_URL=

# Seed only
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
